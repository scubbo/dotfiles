#!/usr/bin/env zsh

set -euo pipefail

if [[ "${1:-}" == --help && $# == 1 ]]; then
  print -- "Copy epsilon's k3s cluster-admin kubeconfig into ~/.kube/config."
  print -- "Run this explicitly in an interactive terminal; existing credentials are not overwritten."
  print -- "This temporary admin shortcut is not a substitute for per-user non-admin access."
  exit 0
fi
if (( $# )); then
  print -u2 -- "Usage: homelab-kubeconfig [--help]"
  exit 1
fi
if [[ -n "${KUBECONFIG:-}" ]]; then
  print -u2 -- "KUBECONFIG is set; no credentials were changed."
  exit 1
fi
if [[ -e "$HOME/.kube/config" || -L "$HOME/.kube/config" ]]; then
  print -u2 -- "Not replacing existing $HOME/.kube/config."
  exit 1
fi
if [[ ! -t 0 || ! -t 1 ]]; then
  print -u2 -- "Run homelab-kubeconfig in an interactive terminal."
  exit 1
fi
for required in ssh scp kubectl mktemp; do
  if (( ! $+commands[$required] )); then
    print -u2 -- "Required command not found: $required"
    exit 1
  fi
done

print -u2 -- "WARNING: This copies a shared CLUSTER-ADMIN credential from epsilon."
print -u2 -- "Per-user non-admin access is the intended replacement; see TODO.md."
print -n -- "Type yes to continue: "
read -r answer
if [[ "$answer" != yes ]]; then
  print -- "No credentials were changed."
  exit 1
fi

repo_root=${0:A:h:h}
source "$repo_root/kubernetes-setup.zsh"
host="scubbo@epsilon.avril"
remote_dir=""
local_file=""

cleanup() {
  local result=$?
  local cleanup_failed=0
  trap - EXIT
  if [[ -n "$local_file" ]] && ! rm -f -- "$local_file"; then
    print -u2 -- "WARNING: Remove the local temporary credential: $local_file"
    cleanup_failed=1
  fi
  if [[ -n "$remote_dir" ]] && ! ssh -T -o BatchMode=no -o ConnectTimeout=10 "$host" \
    "rm -f -- ${(q)remote_dir}/k3s.yaml && rmdir -- ${(q)remote_dir}"; then
    print -u2 -- "WARNING: Remove the temporary credential on $host: $remote_dir/k3s.yaml"
    cleanup_failed=1
  fi
  if (( cleanup_failed )); then
    exit 1
  fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

local_file=$(umask 077; mktemp "${TMPDIR:-/tmp}/homelab-kubeconfig.XXXXXXXX")
remote_dir=$(ssh -T "$host" 'umask 077; mktemp -d "$HOME/.dotfiles-kubeconfig.XXXXXXXX"')
if [[ "$remote_dir" != /* || "$remote_dir" != */.dotfiles-kubeconfig.???????? || "$remote_dir" == *$'\n'* ]]; then
  print -u2 -- "Unexpected remote temporary directory; no credentials were copied."
  remote_dir=""
  exit 1
fi

ssh -tt "$host" "sudo install -m 600 -o \"\$(id -un)\" /etc/rancher/k3s/k3s.yaml ${(q)remote_dir}/k3s.yaml"
scp -q "$host:$remote_dir/k3s.yaml" "$local_file"
chmod 600 "$local_file"
kubernetes_install_config "$local_file" epsilon
print -- "Verify access with: kubectl -n arr-stack get pods"
