# Several of these values are discussed in https://blog.gitbutler.com/how-git-core-devs-configure-git/
[advice]
    statusHints = false
[alias]
    # Log, but shorter :P
    lg = log --format=format:'%C(yellow)%h%Creset %Cred%an%Creset %s' -5
    # Log my commits
    mine = !git log --author=$(git config user.email) --oneline
    co = checkout
    nb = "!f() { default_branch=$(git def) || return; git checkout \"$default_branch\" && git pull && git checkout -b \"$@\"; }; f"
    # "SQuash"
    sq = commit --amend --no-edit
    # "SQuash Amend"
    sqa = commit -a --amend --no-edit
    # Directed Acyclic Graph
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order --branches
    # Directed Acyclic Graph, Limited - without `--branches`, this will only show the references that are passed as arguments
    dagl = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
    # "Back up" - (should probably rename this to clarify that it's not "creating a backup", it's "moving backwards")
    bu = reset --hard HEAD^
    # "Kill The Spare" - delete the branch you were just on
    kts = branch -D @{-1}
    # List branches in descending order of latest commit. Kudos to rsametz@
    comms = branch --sort=-committerdate --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
    clean-branches = "!f() { default_branch=$(git def) || return; current_branch=$(git symbolic-ref --quiet --short HEAD) || { printf '%s\\n' 'Cannot clean branches with a detached HEAD.' >&2; return 1; }; remote_head=$(git ls-remote --symref origin HEAD) || { printf '%s\\n' 'Cannot verify the remote default branch.' >&2; return 1; }; expected=$(printf 'ref: refs/heads/%s\\tHEAD' \"$default_branch\"); printf '%s\\n' \"$remote_head\" | grep -Fxq \"$expected\" || { printf '%s\\n' 'origin/HEAD does not match the remote default; run git fetch origin and git remote set-head origin --auto.' >&2; return 1; }; branches=$(git branch --format='%(refname:short)' --merged) || return; for branch in $branches; do if [ \"$branch\" != \"$default_branch\" ] && [ \"$branch\" != \"$current_branch\" ]; then git branch -d -- \"$branch\" || return; fi; done; }; f"
    rup = reset --hard @{u}
    # Rich interactive recent branch picker - from twolf@
    b = "!git branch --sort=committerdate --format='%(refname:short) (%(creatordate))' | tail -n 10 | fzf --header=\"Checkout Recent Branch\" --preview='git log --oneline --decorate-refs-exclude= -n 10 {+1}' | awk '{print $1}' - | xargs git checkout"
    # Default branch - https://stackoverflow.com/a/67672350
    # origin/HEAD is a local cache and may be stale.
    def = "!f() { ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD) && git show-ref --verify --quiet \"$ref\" || { printf '%s\\n' 'Cannot determine the default branch; run git remote set-head origin --auto.' >&2; return 1; }; case \"$ref\" in refs/remotes/origin/*) printf '%s\\n' \"${ref#refs/remotes/origin/}\" ;; *) printf '%s\\n' 'Invalid origin/HEAD reference.' >&2; return 1 ;; esac; }; f"
    # See link above
    remotesh = remote set-head origin --auto
    # Wipe the existing branch (typically, if its upstream has been merged)
    wipe = "!git checkout $(git def); git branch -D @{-1}; git pull"
[branch]
    sort = -committerdate
[color]
	ui = auto
[column]
    ui = auto
[commit]
    verbose = true
[core]
	pager = less -FMRiX
	excludesfile = ~/.gitignore_global
    fileMode = false
    autocrlf = input
	editor = vim
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    noprefix = true
    wsErrorHighlight = all
[fetch]
    prune = true
    pruneTags = true
    all = true
[include]
    path = ~/.gitconfig-local
[init]
	defaultBranch = main
[help]
    autocorrect = prompt
[rebase]
    autoSquash = true
    autotash = true
    updateRefs = true
[rerere]
    enabled = true
    autoupdate = true
[tag]
    sort = version:refname
[pack]
	windowMemory = 100m
	SizeLimit = 100m
	threads = 1
[pull]
	rebase = true
[push]
	default = simple
	autoSetupRemote = true
    followTags = true
[user]
	email = scubbojj@gmail.com
	name = Jack Jackson
[http]
	postBuffer = 157286400
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
